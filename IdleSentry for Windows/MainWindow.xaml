<ui:FluentWindow x:Class="IdleSentry.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui" xmlns:local="clr-namespace:IdleSentry" mc:Ignorable="d" Title="IdleSentry" Height="680" Width="960" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent">
    <ui:FluentWindow.Resources>
        <!-- Converters -->
        <local:CustomBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <local:SecondsToDurationConverter x:Key="SecondsToDurationConverter" />
        <local:SecondsToTimerConverter x:Key="SecondsToTimerConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        <!-- App rows show status; the shared activity bar owns the countdown. -->
        <DataTemplate x:Key="AppStatusTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="5" Height="5" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="#34D399" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock FontSize="11" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Not running" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Text" Value="Running" />
                                    <Setter Property="Foreground" Value="#34D399" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <!-- Windows 11 Fluent Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Windows 11 Settings Row Card Style -->
        <Style x:Key="FluentSettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <local:DashboardPage x:Key="DashboardPage">
            <ScrollViewer FocusVisualStyle="{x:Null}" IsTabStop="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,24" MaxWidth="920" HorizontalAlignment="Stretch">
                    <!-- Page Header -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="A quieter workspace when you step away." FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Hero Card: Protection Status -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Shield Badge -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#180078D7" Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Center Text -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MonitoringTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding MonitoringDescription}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Right Toggle -->
                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsMonitoring}" AutomationProperties.Name="Enable monitoring" ToolTip="Pause or resume automatic app closing" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                    <!-- Vitals Grid: 3 Summary Cards -->
                    <Grid Margin="0,6,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Card 1: Monitored Apps -->
                        <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Margin="0,0,6,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Monitored Apps" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding MonitoredAppsSummary}" FontSize="20" MinHeight="27" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} running right now">
                                            <Binding Path="RunningAppsCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ui:Button Content="Manage Apps" Click="NavigateTab_Click" Tag="1" Appearance="Secondary" HorizontalAlignment="Left" Padding="10,4" />
                            </StackPanel>
                        </Border>
                        <!-- Card 2: Inactivity Threshold -->
                        <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" Margin="3,0,3,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Timer24" Foreground="#10B981" Margin="0,0,8,0" />
                                    <TextBlock Text="Idle Timeout" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock FontSize="20" MinHeight="27" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SecondsToDurationConverter}">
                                            <Binding Path="GlobalTimeout" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="Default for selected apps" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />
                                <ui:Button Content="Adjust Timer" Click="NavigateTab_Click" Tag="2" Appearance="Secondary" HorizontalAlignment="Left" Padding="10,4" />
                            </StackPanel>
                        </Border>
                        <!-- Card 3: Quit Strategy -->
                        <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Margin="6,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="DismissCircle24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Quit Strategy" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding QuitMethodName}" FontSize="15" MinHeight="27" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding QuitMethodDescription}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />
                                <ui:Button Content="Change Rule" Click="NavigateTab_Click" Tag="2" Appearance="Secondary" HorizontalAlignment="Left" Padding="10,4" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Active App Summary Section -->
                    <TextBlock Text="Your apps" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,6,0,10" />
                    <!-- Empty apps notice -->
                    <Border Style="{StaticResource FluentCardStyle}" Visibility="{Binding MonitoredApps.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverted}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,12">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />
                            <TextBlock Text="Privacy starts with your first app" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Choose a browser, chat app, or any other app you want closed while away." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <ui:Button Appearance="Primary" Click="AddApp_Click" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                                    <TextBlock Text="Add your first app" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                    <!-- Running Apps Compact List -->
                    <ItemsControl ItemsSource="{Binding RunningStates}" Background="Transparent" BorderThickness="0" Visibility="{Binding MonitoredApps.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FluentSettingsCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource AppStatusTemplate}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </local:DashboardPage>
        <local:MonitoredAppsPage x:Key="MonitoredAppsPage">
            <Grid Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Header with Add Action -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Monitored Applications" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Choose which apps close when you step away." FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Appearance="Primary" Click="AddApp_Click" VerticalAlignment="Center" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" Margin="0,0,8,0" />
                            <TextBlock Text="Add Application" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
                <!-- Apps Content Area -->
                <Grid Grid.Row="1">
                    <!-- Empty State -->
                    <Border Style="{StaticResource FluentCardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36" Visibility="{Binding MonitoredApps.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverted}">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,14" HorizontalAlignment="Center" />
                            <TextBlock Text="No apps selected yet" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Choose apps by name from your installed and running applications." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" MaxWidth="380" Margin="0,0,0,18" TextWrapping="Wrap" />
                            <ui:Button Appearance="Primary" Click="AddApp_Click" HorizontalAlignment="Center" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,8,0" />
                                    <TextBlock Text="Choose an application" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                    <!-- List of Monitored Apps -->
                    <ScrollViewer FocusVisualStyle="{x:Null}" IsTabStop="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding MonitoredApps.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding RunningStates}" Background="Transparent" BorderThickness="0" Padding="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FluentSettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- App Icon: Real Extracted Icon with Fallback -->
                                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}" />
                                                <ui:SymbolIcon Symbol="AppGeneric24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="24" Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                            <!-- App Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                            <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource AppStatusTemplate}" VerticalAlignment="Center" Margin="16,0,14,0" />
                                            <!-- Delete Button -->
                                            <ui:Button Grid.Column="3" Appearance="Transparent" Click="DeleteApp_Click" Tag="{Binding Path}" VerticalAlignment="Center" Padding="6" Height="32" Width="32" ToolTip="Remove from protection">
                                                <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" FontSize="16" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </local:MonitoredAppsPage>
        <local:InactivityRulesPage x:Key="InactivityRulesPage">
            <ScrollViewer FocusVisualStyle="{x:Null}" IsTabStop="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,24" MaxWidth="920" HorizontalAlignment="Stretch">
                    <!-- Page Header -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Inactivity Rules &amp; Timers" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Decide when and how your selected apps close." FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Settings Group 1: Timing -->
                    <TextBlock Text="Inactivity Threshold" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <!-- Card: Timeout Slider & Presets -->
                    <Border Style="{StaticResource FluentSettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Timer24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Close apps after" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="How long to wait after your last keyboard or mouse input." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Duration Readout Badge -->
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SecondsToDurationConverter}">
                                                <Binding Path="GlobalTimeout" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <!-- Slider -->
                            <Slider AutomationProperties.Name="Inactivity timeout in seconds" Value="{Binding GlobalTimeout}" Minimum="10" Maximum="3600" TickFrequency="10" IsSnapToTickEnabled="True" Margin="34,0,0,12" />
                            <!-- Quick Preset Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="34,0,0,0">
                                <TextBlock Text="Quick Presets:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap" />
                                <ui:Button Content="1 min" Tag="60" Click="SetPresetTimeout_Click" Appearance="Secondary" Margin="0,0,6,0" Padding="10,3" />
                                <ui:Button Content="5 min" Tag="300" Click="SetPresetTimeout_Click" Appearance="Secondary" Margin="0,0,6,0" Padding="10,3" />
                                <ui:Button Content="15 min" Tag="900" Click="SetPresetTimeout_Click" Appearance="Secondary" Margin="0,0,6,0" Padding="10,3" />
                                <ui:Button Content="30 min" Tag="1800" Click="SetPresetTimeout_Click" Appearance="Secondary" Margin="0,0,6,0" Padding="10,3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Settings Group 2: Quit Behaviors -->
                    <TextBlock Text="Termination Strategy" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />
                    <!-- Card: Quit Method -->
                    <Border Style="{StaticResource FluentSettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="DismissCircle24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Termination Method" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Standard Quit requests a normal close, then forces remaining processes to exit. Force Quit closes immediately. Unsaved changes may be lost with either option." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox AutomationProperties.Name="Quit method" Grid.Column="2" SelectedIndex="{Binding QuitMethod}" VerticalAlignment="Center" Width="170">
                                <ComboBoxItem Content="Standard Quit" />
                                <ComboBoxItem Content="Force Quit" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <!-- Card: Grace Buffer -->
                    <Border Style="{StaticResource FluentSettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Hourglass24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Inactivity Grace Period" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="A short buffer before the inactivity timer begins." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                                <TextBlock Text="1.25 seconds" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </local:InactivityRulesPage>
        <local:SystemStartupPage x:Key="SystemStartupPage">
            <ScrollViewer FocusVisualStyle="{x:Null}" IsTabStop="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,24" MaxWidth="920" HorizontalAlignment="Stretch">
                    <!-- Page Header -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="System &amp; Startup" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Keep IdleSentry ready, with everything stored on this device." FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Startup Setting Card -->
                    <Border Style="{StaticResource FluentSettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Power24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Start in Background at Windows Login" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Launch quietly in the system tray when you sign in." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding LaunchAtStartup}" AutomationProperties.Name="Launch at Windows sign-in" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <!-- Tray Behavior Card -->
                    <Border Style="{StaticResource FluentSettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowMinimize24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="System Tray Operation" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Closing this window hides it in the system tray so IdleSentry continues protecting your machine in the background." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                                <TextBlock Text="Runs in tray" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Storage Location Card -->
                    <Border Style="{StaticResource FluentSettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Data Storage &amp; Portability" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Preferences are saved in %LOCALAPPDATA%\IdleSentry\settings.json with zero cloud transmission." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="Open Folder" Click="OpenSettingsFolder_Click" Appearance="Secondary" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </local:SystemStartupPage>
        <local:AboutPage x:Key="AboutPage">
            <ScrollViewer FocusVisualStyle="{x:Null}" IsTabStop="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,24" MaxWidth="720" HorizontalAlignment="Center">
                    <!-- Hero About Card -->
                    <Border Style="{StaticResource FluentCardStyle}" Padding="28">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- App Icon -->
                            <Image Source="pack://application:,,,/IdleSentry;component/IdleSentry.png" Width="64" Height="64" Margin="0,0,0,14" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="IdleSentry" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border Background="#200078D7" CornerRadius="10" Padding="10,2" Margin="0,4,0,14" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Static local:AppInfo.AboutVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="A native, lightweight background utility designed to protect your active workspace by automatically terminating sensitive applications when you step away." FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" LineHeight="18" MaxWidth="480" Margin="0,0,0,16" TextWrapping="Wrap" />
                            <TextBlock Text="Works entirely on your device. No telemetry or trackers." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FluentSettingsCardStyle}" Margin="0,8,0,0" DataContext="{x:Static local:UpdateService.Shared}">
                        <StackPanel>
                            <TextBlock Text="Software updates" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Status}" Margin="0,8,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            <CheckBox Content="Check for updates automatically" IsChecked="{Binding AutomaticChecks}" Margin="0,0,0,8" />
                            <TextBlock Text="Checks GitHub for releases. Downloads and installation require your approval. Your monitored apps and activity stay on this PC." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <WrapPanel>
                                <ui:Button Content="Check for Updates" Click="CheckUpdates_Click" IsEnabled="{Binding CanCheck}" Margin="0,0,8,8" />
                                <ui:Button Content="Download Update" Click="DownloadUpdate_Click" IsEnabled="{Binding CanDownload}" Margin="0,0,8,8" />
                                <ui:Button Content="Install &amp; Restart" Click="InstallUpdate_Click" IsEnabled="{Binding CanInstall}" Appearance="Primary" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Credits Card -->
                    <Border Style="{StaticResource FluentSettingsCardStyle}" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Developer: Anush Vishwakarma" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Website: zennoris.com" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,16,0" TextWrapping="Wrap" />
                                <TextBlock Text="Copyright © 2026 Zennoris. Distributed under Apache License 2.0." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Visit website" Click="OpenWebsite_Click" Appearance="Secondary" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Open zennoris.com" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </local:AboutPage>
    </ui:FluentWindow.Resources>
    <ui:NavigationView x:Name="SidebarNavigation" PaneDisplayMode="Left" IsPaneOpen="True" IsPaneToggleVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="SidebarNavigation_SelectionChanged">
        <ui:NavigationView.Resources>
            <!-- The shared indicator below supplies the connected selection motion. -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
        </ui:NavigationView.Resources>
        <ui:NavigationView.PaneHeader>
            <Grid Margin="6,2,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Grid.RowSpan="2" Grid.Column="0" Source="pack://application:,,,/IdleSentry;component/IdleSentry.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="2" Text="IdleSentry" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static local:AppInfo.SidebarVersion}" FontSize="10" Margin="0,1,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </ui:NavigationView.PaneHeader>
        <ui:NavigationView.PaneFooter>
            <Border x:Name="ActivityBar" Padding="12" Margin="0,18,0,0" CornerRadius="8" BorderThickness="1" ToolTip="Keyboard or mouse activity resets the inactivity countdown.">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#08FFFFFF" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCloseImminent}" Value="True">
                                <Setter Property="Background" Value="#14F59E0B" />
                                <Setter Property="BorderBrush" Value="#50F59E0B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Button x:Name="ActivityQueueButton" Click="ActivityQueue_Click" IsEnabled="{Binding HasClosingQueue}"
                            Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding ClosingQueueHint}" ToolTip="{Binding ClosingQueueHint}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Timer24" FontSize="17" Foreground="#FBBF24" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ActivityCountdown" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold" Foreground="#FBBF24" Text="{Binding CountdownValue, Converter={StaticResource SecondsToTimerConverter}}" Visibility="{Binding HasAppsPendingClose, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Time until the next app closes" />
                                <StackPanel Visibility="{Binding HasAppsPendingClose, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel Margin="0,3,0,2">
                                        <TextBlock Text="›" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Next to close" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NextClosingApp" Text="{Binding NextClosingAppName}" ToolTip="{Binding NextClosingAppName}"
                                                   FontSize="10.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ClosingQueueAdditionalText}" FontSize="10" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding ClosingQueueAdditionalCount, Converter={StaticResource IntToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock Text="{Binding ActivityStatusText}" FontSize="10.5" TextWrapping="Wrap" MaxHeight="32"
                                           Visibility="{Binding HasAppsPendingClose, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Popup x:Name="ClosingQueuePopup" Placement="Right" PlacementTarget="{Binding ElementName=ActivityBar}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="ClosingQueuePopup_Opened"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <Border Width="352" Padding="16" Margin="8" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                PreviewKeyDown="ClosingQueue_PreviewKeyDown" AutomationProperties.Name="Closing queue">
                            <StackPanel>
                                <TextBlock Text="Closing queue" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding ClosingQueueDescription}" Margin="0,4,0,14" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ScrollViewer x:Name="ClosingQueueScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Closing queue applications">
                                    <ItemsControl x:Name="ClosingQueueItems" ItemsSource="{Binding ClosingQueue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="52" Margin="0,0,4,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" Stretch="Uniform" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeRemaining, Converter={StaticResource SecondsToTimerConverter}}" FontFamily="Consolas" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Keyboard or mouse activity resets these timers." TextWrapping="Wrap" FontSize="10.5" Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </ui:NavigationView.PaneFooter>
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="NavDashboard" Content="Dashboard" TargetPageTag="0" TargetPageType="{x:Type local:DashboardPage}" IsPaneOpen="True" Margin="0,2" Height="40">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Home24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavApps" Content="Monitored Apps" TargetPageTag="1" TargetPageType="{x:Type local:MonitoredAppsPage}" IsPaneOpen="True" Margin="0,2" Height="40">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Apps24" />
                </ui:NavigationViewItem.Icon>
                <ui:NavigationViewItem.InfoBadge>
                    <ui:InfoBadge x:Name="RunningAppsBadge" Value="{Binding RunningAppsCount}" Width="16" Height="16" MinWidth="16" MinHeight="16" Padding="0" Margin="4,0,8,0" VerticalAlignment="Center" Background="#DC2626" Foreground="White" Visibility="{Binding RunningAppsCount, Converter={StaticResource IntToVisibilityConverter}}" AutomationProperties.Name="{Binding RunningAppsCount, StringFormat='Running monitored apps: {0}'}">
                        <ui:InfoBadge.Template>
                            <ControlTemplate TargetType="ui:InfoBadge">
                                <Grid Width="16" Height="16">
                                    <Ellipse x:Name="BadgeCircle" Fill="{TemplateBinding Background}" />
                                    <TextBlock Text="{TemplateBinding Value}" Foreground="{TemplateBinding Foreground}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </ui:InfoBadge.Template>
                    </ui:InfoBadge>
                </ui:NavigationViewItem.InfoBadge>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavRules" Content="Inactivity Rules" TargetPageTag="2" TargetPageType="{x:Type local:InactivityRulesPage}" IsPaneOpen="True" Margin="0,2" Height="40">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Timer24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavStartup" Content="System &amp; Startup" TargetPageTag="3" TargetPageType="{x:Type local:SystemStartupPage}" IsPaneOpen="True" Margin="0,2" Height="40">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Desktop24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavAbout" Content="About" TargetPageTag="4" TargetPageType="{x:Type local:AboutPage}" IsPaneOpen="True" Margin="0,2" Height="40">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <ui:NavigationView.Template>
            <ControlTemplate TargetType="ui:NavigationView">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TitleBar Grid.Column="1" Height="36" Background="Transparent" />
                    <Border Grid.RowSpan="2" Background="#28000000" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                        <Grid Margin="12,14,12,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Content="{TemplateBinding PaneHeader}" />
                            <Grid x:Name="NavigationRegion" Grid.Row="1" SizeChanged="NavigationRegion_SizeChanged">
                                <ScrollViewer FocusVisualStyle="{x:Null}" IsTabStop="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PART_MenuItemsItemsControl" Margin="4,0" Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                                <Rectangle x:Name="SelectionIndicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" Visibility="Collapsed">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <ItemsControl x:Name="PART_FooterMenuItemsItemsControl" Visibility="Collapsed" />
                            <ContentPresenter Grid.Row="2" Content="{TemplateBinding PaneFooter}" />
                        </Grid>
                    </Border>
                    <ui:NavigationViewContentPresenter x:Name="PART_NavigationViewContentPresenter" Grid.Row="1" Grid.Column="1" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" IsTabStop="False" TransitionDuration="0" />
                </Grid>
            </ControlTemplate>
        </ui:NavigationView.Template>
    </ui:NavigationView>
</ui:FluentWindow>
