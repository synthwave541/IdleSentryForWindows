<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>IdleSentry.ico</ApplicationIcon>

    <!-- Assembly Metadata matching macOS release -->
    <AssemblyName>IdleSentry</AssemblyName>
    <RootNamespace>IdleSentry</RootNamespace>
    <!-- Matches ../IdleSentry/version.info. The UI reads this assembly metadata. -->
    <Version>1.0.10</Version>
    <Product>IdleSentry</Product>
    <Company>Zennoris</Company>
    <Copyright>Copyright © 2026 Zennoris. All rights reserved.</Copyright>
    <Description>Native background privacy sentry that automatically terminates sensitive applications when the machine goes idle.</Description>

    <!-- Publishing & Release Optimizations -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="wpf-ui" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="IdleSentry.ico" />
    <Resource Include="IdleSentry.png" />
  </ItemGroup>

</Project>
