<ui:FluentWindow x:Class="IdleSentry.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        xmlns:local="clr-namespace:IdleSentry"
        Title="Choose apps" Width="620" Height="610" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <ui:FluentWindow.Resources>
        <local:CustomBooleanToVisibilityConverter x:Key="BoolVisibility" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Height="36" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="24,8,24,16">
            <TextBlock Text="Choose apps" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Select the apps you want to close when you step away."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search apps by name"
                        AutomationProperties.Name="Search apps" TextChanged="Search_TextChanged" />
            <ui:Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="Refresh_Click"
                       Margin="10,0,0,0" ToolTip="Find newly opened or installed apps" />
        </Grid>
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="ResultsText" Text="Finding installed and running apps…" FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="3" Margin="0,0,0,8" />
            </StackPanel>
            <ListBox x:Name="AppList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Available apps">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelect}" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Path}">
                                <Grid Margin="8,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}}" />
                                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="22"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}, ConverterParameter=Inverted}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No matching apps. Try another name, or open the app and refresh."
                       Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <StackPanel Grid.Row="4" Margin="24,12,24,20">
            <TextBlock Text="Missing an app? Open it and refresh, or browse for it below."
                       FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BrowseButton" Content="Browse…" Click="Browse_Click" ToolTip="Choose an application executable manually" />
                <ui:Button Grid.Column="2" Content="Cancel" IsCancel="True" Margin="12,0,8,0" />
                <ui:Button x:Name="AddButton" Grid.Column="3" Content="Add apps" Appearance="Primary"
                           IsEnabled="False" IsDefault="True" Click="Add_Click" MinWidth="100" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
