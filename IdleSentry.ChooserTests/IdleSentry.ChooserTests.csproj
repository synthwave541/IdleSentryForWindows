<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(DistributionChannel)' == 'Store'">net8.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants Condition="'$(DistributionChannel)' == 'Store'">$(DefineConstants);STORE</DefineConstants>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IdleSentry.ChooserTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IdleSentry for Windows/IdleSentry.csproj" />
    <Compile Remove="UpdateChecks.cs" Condition="'$(DistributionChannel)' == 'Store'" />
  </ItemGroup>
</Project>
